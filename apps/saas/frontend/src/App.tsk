import { useState, useRef, useEffect } from 'react'

// Point this to your Render backend
const API_URL = 'https://netsleuth-api.onrender.com';

export default function App() {
  const [domain, setDomain] = useState('')
  const [status, setStatus] = useState<'idle' | 'scanning' | 'done' | 'error'>('idle')
  const [logs, setLogs] = useState<string[]>([])
  const [progress, setProgress] = useState(0)
  const [grade, setGrade] = useState<string | null>(null)
  const terminalRef = useRef<HTMLDivElement>(null)

  // Auto-scroll terminal
  useEffect(() => {
    if (terminalRef.current) {
      terminalRef.current.scrollTop = terminalRef.current.scrollHeight
    }
  }, [logs])

  const handleScan = async () => {
    if (!domain) return
    setStatus('scanning')
    setLogs([`$ netsleuth scan ${domain}`, '─────────────────────────────────────────'])
    setProgress(0)
    setGrade(null)

    try {
      // 1. Start the scan
      const res = await fetch(`${API_URL}/scan/start?domain=${encodeURIComponent(domain)}`)
      const data = await res.json()
      
      if (!data.scan_id) throw new Error(data.error || 'Failed to start scan')

      setLogs(prev => [...prev, `✓ Scan queued. ID: ${data.scan_id.substring(0, 8)}...`])

      // 2. Connect to SSE Stream
      const eventSource = new EventSource(`${API_URL}/scan/stream/${data.scan_id}`)
      
      eventSource.onmessage = (event) => {
        const payload = JSON.parse(event.data)
        
        // Update progress
        setProgress(payload.progress)
        
        // Add log for newly completed modules
        if (payload.modules && payload.modules.length > 0) {
          const latestModule = payload.modules[payload.modules.length - 1]
          if (latestModule && !logs.includes(`✓ ${latestModule.module_name} completed`)) {
             setLogs(prev => [...prev, `✓ ${latestModule.module_name} completed (${latestModule.duration_ms}ms)`])
          }
        }

        // Check if done
        if (payload.status === 'completed') {
          eventSource.close()
          setStatus('done')
          setLogs(prev => [...prev, `✓ Scan complete. Calculating grade...`])
          
          // Calculate a dummy grade based on progress for now (We'll add real grading in Phase 7)
          setTimeout(() => setGrade('B+'), 1000) 
        } else if (payload.status === 'failed') {
          eventSource.close()
          setStatus('error')
          setLogs(prev => [...prev, `✗ Scan failed.`])
        }
      }

      eventSource.onerror = () => {
        eventSource.close()
        setStatus('error')
        setLogs(prev => [...prev, `✗ Connection lost.`])
      }

    } catch (err: any) {
      setStatus('error')
      setLogs(prev => [...prev, `✗ Error: ${err.message}`])
    }
  }

  return (
    <div className="min-h-screen flex flex-col items-center justify-center p-6 bg-background text-white transition-all duration-500">
      
      {/* Header */}
      <div className="text-center mb-12">
        <h1 className="text-4xl md:text-6xl font-bold tracking-tight mb-4">
          NetSleuth
        </h1>
        <p className="text-gray-400 text-lg md:text-xl max-w-md mx-auto">
          See what hackers see. <span className="text-accent">Before they do.</span>
        </p>
      </div>

      {/* Input Area (Idle State) */}
      {status === 'idle' && (
        <div className="w-full max-w-lg animate-fade-in">
          <div className="flex gap-2 bg-surface p-2 rounded-2xl border border-white/10 shadow-2xl">
            <input
              type="text"
              value={domain}
              onChange={(e) => setDomain(e.target.value)}
              placeholder="example.com"
              className="flex-1 bg-transparent px-4 py-3 text-lg outline-none placeholder-gray-500"
              onKeyDown={(e) => e.key === 'Enter' && handleScan()}
            />
            <button
              onClick={handleScan}
              className="bg-accent hover:bg-blue-600 text-white font-semibold px-8 py-3 rounded-xl transition-all active:scale-95"
            >
              Probe
            </button>
          </div>
          <p className="text-center text-gray-500 text-sm mt-4">
            11 security checks · No signup required · 60 seconds
          </p>
        </div>
      )}

      {/* Scanning Theater (Scanning State) */}
      {status === 'scanning' && (
        <div className="w-full max-w-2xl animate-fade-in">
          <div className="flex items-center justify-between mb-4">
            <span className="text-gray-400 text-sm font-mono">Scanning {domain}...</span>
            <span className="text-accent font-bold">{progress}%</span>
          </div>
          
          {/* Progress Bar */}
          <div className="w-full bg-surface rounded-full h-2 mb-6 overflow-hidden">
            <div 
              className="bg-accent h-2 rounded-full transition-all duration-500 ease-out"
              style={{ width: `${progress}%` }}
            ></div>
          </div>

          {/* Terminal Log */}
          <div 
            ref={terminalRef}
            className="bg-black/50 border border-white/10 rounded-xl p-4 h-64 overflow-y-auto font-mono text-sm text-gray-300 terminal"
          >
            {logs.map((log, i) => (
              <div 
                key={i} 
                className={`mb-1 ${log.startsWith('✓') ? 'text-success' : log.startsWith('✗') ? 'text-critical' : 'text-gray-400'}`}
              >
                {log}
              </div>
            ))}
            <div className="inline-block w-2 h-4 bg-accent animate-pulse ml-1"></div>
          </div>
        </div>
      )}

      {/* Results (Done State) */}
      {status === 'done' && grade && (
        <div className="w-full max-w-lg text-center animate-fade-in">
           <div className="text-8xl font-bold text-success mb-4 animate-bounce">
             {grade}
           </div>
           <h2 className="text-2xl font-semibold mb-2">Scan Complete</h2>
           <p className="text-gray-400 mb-8">We found a few things you should look at.</p>
           <button
             onClick={() => { setStatus('idle'); setLogs([]); setProgress(0); }}
             className="bg-surface hover:bg-gray-800 text-white font-semibold px-8 py-3 rounded-xl border border-white/10 transition-all"
           >
             Scan Another Site
           </button>
        </div>
      )}

    </div>
  )
    } 
